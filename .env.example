# Local defaults require no secrets. Keep the actual .env file out of Git.
WAYPOINT_DATA=./data/workspace

# Set these only when hosting the backend publicly.
# WAYPOINT_PUBLIC=1
# WAYPOINT_ADMIN_PASSWORD=replace-with-a-long-random-password
# WAYPOINT_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# The Android recorder connects directly to the backend over pinned HTTPS.
# Never commit device tokens or TLS private keys.
